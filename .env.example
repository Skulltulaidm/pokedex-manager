POSTGRES_USER=pokedex
POSTGRES_PASSWORD=pokedex
POSTGRES_DB=pokedex
POSTGRES_PORT=5433

# Browser-facing URLs. The web container reaches the API by service name
# instead; see NEXT_PUBLIC_API_URL vs API_INTERNAL_URL in web/.env.example.
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=change-me-openssl-rand-base64-32

# 8000 is taken by another local service; the container still uses 8000 internally.
API_PORT=8010
WEB_PORT=3000

# Chat and vision. Everything else works without it: the chat answers 503 and a
# scan degrades to manual entry.
GOOGLE_API_KEY=
AGENT_MODEL=google-gla:gemini-flash-latest
VISION_MODEL=google-gla:gemini-flash-latest
