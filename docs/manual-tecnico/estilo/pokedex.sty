% ---------------------------------------------------------------------------
% Tables. One house style: graphite header row, striped body, no vertical rules.
% ---------------------------------------------------------------------------
% `pktable` breaks across pages and repeats its header; `pkbox` stays on one page.
\NewTblrEnviron{pktable}
\SetTblrInner[pktable]{
  row{1}={bg=pkGraphite,fg=white,font=\pksb\scriptsize},
  row{2-Z}={font=\scriptsize},
  row{even}={bg=pkRaised},
  rowsep=2.4pt, colsep=5pt,
  hlines={0.3pt,pkRule},
  rowhead=1,
  width=\linewidth}
\SetTblrOuter[pktable]{long}
% tabularray's default continuation strings are English.
\DefTblrTemplate{contfoot-text}{normal}{\footnotesize\itshape\color{pkMuted}Continúa en la página siguiente}
\SetTblrTemplate{contfoot-text}{normal}
\DefTblrTemplate{conthead-text}{normal}{\footnotesize\itshape\color{pkMuted}(continuación)}
\SetTblrTemplate{conthead-text}{normal}
\DefTblrTemplate{caption-sep}{normal}{.\enskip}
\SetTblrTemplate{caption-sep}{normal}

\NewTblrEnviron{pkbox}
\SetTblrInner[pkbox]{
  row{1}={bg=pkGraphite,fg=white,font=\pksb\scriptsize},
  row{2-Z}={font=\scriptsize},
  row{even}={bg=pkRaised},
  rowsep=2.4pt, colsep=5pt,
  hlines={0.3pt,pkRule},
  width=\linewidth}

