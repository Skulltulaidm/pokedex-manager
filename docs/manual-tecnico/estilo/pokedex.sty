\newcommand{\pkheadfont}{\pksb\footnotesize}

\fancypagestyle{pokedex}{%
  \fancyhf{}
  \renewcommand{\headrulewidth}{0pt}
  \renewcommand{\footrulewidth}{0pt}
  \fancyhead[L]{\pkheadfont\color{pkGraphite}\pkdocname}
  \fancyhead[R]{\pkheadfont\color{pkMuted}\MakeUppercase{\pkclass}}
  \fancyfoot[L]{\pkheadfont\color{pkMuted}\pkproject\ \textperiodcentered\ v\pkversion}
  \fancyfoot[R]{\pkheadfont\color{pkGraphite}\thepage\,/\,\pageref{LastPage}}
  % A hairline under the header, with the red tick the cover uses.
  \fancyhead[C]{%
    \begin{tikzpicture}[remember picture,overlay]
      \draw[pkRule,line width=0.4pt]
        ($(current page.north west)+(2.5cm,-2.35cm)$) --
        ($(current page.north east)+(-2.5cm,-2.35cm)$);
      \draw[pkRed,line width=1.4pt]
        ($(current page.north west)+(2.5cm,-2.35cm)$) --
        ($(current page.north west)+(3.4cm,-2.35cm)$);
    \end{tikzpicture}}
  \fancyfoot[C]{%
    \begin{tikzpicture}[remember picture,overlay]
      \draw[pkRule,line width=0.4pt]
        ($(current page.south west)+(2.5cm,2.0cm)$) --
        ($(current page.south east)+(-2.5cm,2.0cm)$);
    \end{tikzpicture}}
}
\pagestyle{pokedex}

