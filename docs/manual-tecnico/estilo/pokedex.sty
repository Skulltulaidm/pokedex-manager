\definecolor{pkInk}{HTML}{0E0D0D}
\definecolor{pkGraphite}{HTML}{2C2E33}
\definecolor{pkNight}{HTML}{0F121F}
\definecolor{pkMuted}{HTML}{5C5A5B}
