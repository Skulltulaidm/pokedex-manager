% Inline literals. Identifiers in this codebase are long and unbreakable, and a
% narrow table column has nowhere to put them: `\_` is redefined inside the group
% so every underscore becomes a break opportunity.
\DeclareRobustCommand{\pkus}{\textunderscore\allowbreak}
\DeclareRobustCommand{\pkcode}[1]{{\ttfamily\small\color{pkRedDeep}\let\_\pkus #1}}
\DeclareRobustCommand{\pkpath}[1]{{\ttfamily\small\color{pkGraphite}\let\_\pkus #1}}

% An identifier badge for requirement tables.
\newcommand{\pkid}[1]{{\pksb\footnotesize\color{pkRedDeep}#1}}

% ---------------------------------------------------------------------------
% The pokeball, drawn once and reused at any size. `#1` is the radius.
% ---------------------------------------------------------------------------
\newcommand{\pkball}[4]{%
  % #1 radius, #2 top colour, #3 bottom colour, #4 line colour
  \begin{scope}
    \clip (0,0) circle (#1);
    \fill[#3] (-#1,-#1) rectangle (#1,#1);
    \fill[#2] (-#1,0) rectangle (#1,#1);
    \draw[#4,line width=#1*0.11] (-#1,0) -- (#1,0);
  \end{scope}
  \draw[#4,line width=#1*0.055] (0,0) circle (#1);
  \fill[#4] (0,0) circle (#1*0.30);
  \fill[#2] (0,0) circle (#1*0.20);
  \draw[#4,line width=#1*0.045] (0,0) circle (#1*0.20);
}

% ---------------------------------------------------------------------------
% Cover
% ---------------------------------------------------------------------------
\newcommand{\pkcover}[2]{%
  % #1 title, #2 subtitle
  \begin{titlepage}
  \thispagestyle{empty}
  \begin{tikzpicture}[remember picture,overlay]
    \fill[pkNight] (current page.south west) rectangle (current page.north east);

    % Geometry: an oversized pokeball bled off the lower-right corner, plus the
    % flat bands the cover of the reference document uses.
    \begin{scope}[shift={($(current page.south east)+(-1.2cm,3.2cm)$)}]
      \pkball{7.4cm}{pkRed!88!black}{pkNight!85!white}{pkNight!60!white}
    \end{scope}
    \begin{scope}[opacity=0.55]
      \fill[pkRed] ($(current page.north west)+(0,-0.9cm)$)
        rectangle ($(current page.north west)+(4.2cm,-1.05cm)$);
      \fill[white!35!pkNight] ($(current page.north west)+(4.6cm,-0.9cm)$)
        rectangle ($(current page.north west)+(6.0cm,-1.05cm)$);
    \end{scope}
    \draw[white,opacity=0.10,line width=0.5pt]
      ($(current page.north west)+(2.4cm,0)$) -- ($(current page.south west)+(2.4cm,0)$);

    % Eyebrow, title, rule, subtitle.
    \node[anchor=north west, align=left, inner sep=0]
      at ($(current page.north west)+(2.4cm,-4.6cm)$)
      {\pksb\footnotesize
       \textcolor{pkRedLight}{\MakeUppercase{Documentación de ingeniería}}\;%
       \textcolor{white!55!pkNight}{|}\;%
       \textcolor{white!72!pkNight}{\MakeUppercase{\pkclass}}};

    \node[anchor=north west, align=left, inner sep=0, text width=13cm]
      at ($(current page.north west)+(2.4cm,-5.4cm)$)
      {\sffamily\bfseries\fontsize{40}{44}\selectfont\color{white}#1};

    \fill[pkRed] ($(current page.north west)+(2.4cm,-8.6cm)$)
      rectangle ($(current page.north west)+(4.0cm,-8.72cm)$);

    \node[anchor=north west, align=left, inner sep=0, text width=11cm]
      at ($(current page.north west)+(2.4cm,-9.4cm)$)
      {\sffamily\fontsize{13}{18}\selectfont\color{white!70!pkNight}\raggedright #2\par};

    % The stack, set small in mono: it tells an engineer what this is before
    % the contents page does.
    % `align=left` without a text width uses TeX's alignment machinery, where a
    % font or colour set inside the first row does not survive the row break.
    % Both go on the node instead.
    \node[anchor=north west, align=left, inner sep=0,
          font=\ttfamily\scriptsize, text=white!62!pkNight]
      at ($(current page.north west)+(2.4cm,-11.4cm)$)
      {FastAPI\;\textperiodcentered\;SQLAlchemy\;\textperiodcentered\;PostgreSQL~18\\[3pt]
       Next.js~16\;\textperiodcentered\;React~19\;\textperiodcentered\;TanStack~Query\\[3pt]
       Model~Context~Protocol\;\textperiodcentered\;Turborepo};

    % Metadata block, ruled like a spec sheet.
    \node[anchor=south west, inner sep=0] at ($(current page.south west)+(2.4cm,3.1cm)$)
      {\begin{minipage}{9.2cm}
        \color{white}
        \sffamily\footnotesize
        \setlength{\tabcolsep}{0pt}
        \renewcommand{\arraystretch}{1.75}
        \begin{tabular}{@{}p{3.1cm}p{6.0cm}@{}}
          \arrayrulecolor{white!35!pkNight}\hline
          \textcolor{white!62!pkNight}{PROYECTO} & \pkproject \\ \hline
          \textcolor{white!62!pkNight}{VERSIÓN}  & \pkversion \\ \hline
          \textcolor{white!62!pkNight}{FECHA}    & \pkdate \\ \hline
          \textcolor{white!62!pkNight}{ESTADO}   & \pkstatus \\ \hline
        \end{tabular}
      \end{minipage}};

    \node[anchor=south west, inner sep=0] at ($(current page.south west)+(2.4cm,1.6cm)$)
      {\sffamily\scriptsize\color{white!58!pkNight}
       \MakeUppercase{\pkdocname}};
  \end{tikzpicture}
  \end{titlepage}}

