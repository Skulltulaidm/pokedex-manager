% ---------------------------------------------------------------------------
% Headings. Chapter numbers are set in red at display size beside the title.
% ---------------------------------------------------------------------------
\titleformat{\chapter}[display]
  {\sffamily\bfseries\color{pkInk}}
  {\normalfont\sffamily\fontsize{54}{54}\selectfont\color{pkRed}\thechapter
   \hspace{0.35em}\textcolor{pkRule}{\rule[0.12em]{1.6cm}{1.2pt}}}
  {8pt}
  {\fontsize{24}{28}\selectfont\raggedright}
  [\vspace{-6pt}{\color{pkRule}\rule{\textwidth}{0.4pt}}]

\titleformat{\section}
  {\sffamily\bfseries\large\color{pkInk}}
  {\color{pkRed}\thesection}{0.7em}{}
\titleformat{\subsection}
  {\pksb\normalsize\color{pkGraphite}}
  {\color{pkRed}\thesubsection}{0.6em}{}
\titleformat{\subsubsection}
  {\pksb\small\color{pkGraphite}}
  {\color{pkRedDeep}\thesubsubsection}{0.6em}{}

\titlespacing*{\chapter}{0pt}{0pt}{22pt}
\titlespacing*{\section}{0pt}{18pt}{6pt}
\titlespacing*{\subsection}{0pt}{13pt}{4pt}
\titlespacing*{\subsubsection}{0pt}{11pt}{3pt}

