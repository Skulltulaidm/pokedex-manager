\definecolor{pkRule}{HTML}{D8D6D6}
\definecolor{pkRing}{HTML}{1F7DCF}
\definecolor{pkStar}{HTML}{C88B00}

% Text-safe variants. The app's red has too little luminance to sit on the dark
% cover (3.6:1) and the mid greens/blues fail AA at body sizes, so anything that
% is read rather than merely seen uses these. Every pair in this document was
% measured against WCAG AA: 4.5:1 normal, 3:1 for large type.
\definecolor{pkRedLight}{HTML}{FF6B6B}
\definecolor{pkString}{HTML}{146018}

% Type accents, used to colour-code families of material.
% Darkened one step from the app's own tokens so white type sits on them at AA.
\definecolor{tFire}{HTML}{B93800}
\definecolor{tWater}{HTML}{0063B4}
\definecolor{tGrass}{HTML}{186B22}
\definecolor{tElectric}{HTML}{8A6300}
\definecolor{tPsychic}{HTML}{A82A69}
\definecolor{tSteel}{HTML}{4C6874}
\definecolor{tDragon}{HTML}{4038B8}
\definecolor{tGhost}{HTML}{5F3596}

% Font switches. `sourcesanspro` only remaps \sfdefault; it exposes no family
% command of its own, so the document declares the two it uses.
% Long unbreakable identifiers in running text; let TeX stretch rather than
% push a line into the margin.
\setlength{\emergencystretch}{2.5em}

\newcommand{\pksans}{\sffamily}
\newcommand{\pksb}{\sffamily\fontseries{sb}\selectfont}

