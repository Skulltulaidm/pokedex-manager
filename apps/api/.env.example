DATABASE_URL=postgresql+asyncpg://pokedex:pokedex@localhost:5433/pokedex
# Every browser origin allowed to call this API, comma separated.
CORS_ORIGINS=http://localhost:3000

AUTH_JWKS_URL=http://localhost:3000/api/auth/jwks
AUTH_ISSUER=http://localhost:3000
AUTH_AUDIENCE=http://localhost:3000

# Chat only. Everything else works without it: the endpoint answers 503 and the
# rest of the app is unaffected.
GOOGLE_API_KEY=
AGENT_MODEL=google-gla:gemini-flash-latest

# Where scan photos land. In Docker this points at the scan_images volume
# (/data/scans); locally it is a gitignored directory under apps/api.
STORAGE_ROOT=./data/scans
